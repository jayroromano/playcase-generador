# Playcase · variables de entorno
# Copia este archivo como .env.local (o configúralas en Vercel) y rellena solo lo que necesites.
# No subas nunca el archivo con valores reales al repositorio.

# Abre las APIs al público (true) para que los clientes busquen sin contraseña.
# Si no es true, search/resolve/img exigen sesión de administrador o la cabecera heredada x-key.
PLAYCASE_PUBLIC_API=true

# Orígenes autorizados para el iframe y para postMessage, separados por comas.
# Deben incluir el dominio exacto de la tienda (sin barra final).
# Ejemplo de formato: https://mi-tienda.myshopify.com,https://www.mi-dominio.com
PLAYCASE_ALLOWED_ORIGINS=

# Clave de administrador. Es obligatoria para entrar en el panel de administración,
# incluso con PLAYCASE_PUBLIC_API=true. Si no se define, se usa ACCESS_KEY.
ADMIN_KEY=

# Clave interna heredada. También sirve como ADMIN_KEY si no defines ADMIN_KEY.
ACCESS_KEY=

# Secreto para firmar la cookie de sesión.
# OBLIGATORIO en producción: mínimo 32 caracteres y distinto de ADMIN_KEY.
# Si falta, es corto o coincide con la clave, el panel admin queda deshabilitado (503).
# En local es opcional: si no se define, se usa la clave de administrador.
PLAYCASE_SESSION_SECRET=

# Credenciales opcionales de Spotify (solo servidor, nunca en el navegador).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
